<link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">

<section class="password-landing" role="main" aria-labelledby="coming-title">
  <div class="stage password-stage">
    {% if section.settings.show_logo %}
      <!-- Provide intrinsic width/height to avoid layout shifts and satisfy theme-check ImgWidthAndHeight.
           CSS below keeps the image responsive (max-width and height:auto). Adjust the numeric values
           480x120 to match your actual logo's intrinsic size if you have it. -->
      <img src="{{ 'Logo.svg' | asset_url }}" alt="{{ shop.name }} logo" class="logo" id="moonbeam-logo" width="480" height="120">
    {% endif %}

    <h1 id="coming-title" class="title">{{ section.settings.heading | default: "Coming soon…" }}</h1>

    <div class="countdown" aria-live="polite" aria-label="Time remaining until October 1, 2026">
      <div class="countdown-item">
        <div class="countdown-value" id="days">0</div>
        <div class="countdown-label">Days</div>
      </div>
      <div class="countdown-item">
        <div class="countdown-value" id="hours">0</div>
        <div class="countdown-label">Hours</div>
      </div>
      <div class="countdown-item">
        <div class="countdown-value" id="minutes">0</div>
        <div class="countdown-label">Minutes</div>
      </div>
      <div class="countdown-item">
        <div class="countdown-value" id="seconds">0</div>
        <div class="countdown-label">Seconds</div>
      </div>
    </div>

    <p class="sub">{{ section.settings.lead_text | default: "Moonbeam-Merch is getting ready. Stay tuned." }}</p>

    <!-- CENTERED & STYLED SHOPIFY PASSWORD FORM -->
    <div class="password-wrapper">
      <form method="post" action="/password" class="password-form" aria-label="Store password">
        <label for="password_input" class="visually-hidden">Store password</label>
        <input id="password_input" name="password" type="password" placeholder="Enter password" aria-label="Store password" class="password-input">
        <button type="submit" class="password-button">Enter</button>
      </form>
      {% if section.settings.show_help_text %}
        <div class="password-help">{{ section.settings.help_text }}</div>
      {% endif %}
    </div>
  </div>
</section>

<style>
/* Layout overrides to center and simplify the page for password view */
.password-stage{ display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:80vh; padding:4vw; }

/* Provide responsive rules for the logo while keeping intrinsic size attributes for layout stability */
.logo{
  display:block;
  /* keep the original intent: cap the logo at a percentage of viewport but don't exceed intrinsic width */
  max-width: min(36vw, 480px);
  width: 36vw;
  height: auto; /* ensure image scales proportionally */
  margin-bottom:0.6rem;
}

/* If you prefer the logo hidden by default, control via section setting `show_logo` in the editor */

/* Tighten title and subtext */
.title{ margin:0 0 0.6rem 0; text-align:center; font-size:clamp(1.4rem,3.2vw,2.2rem); }
.sub{ margin:0 0 1rem 0; text-align:center; }

/* Centered password area */
.password-wrapper{ display:flex; flex-direction:column; align-items:center; gap:0.6rem; margin-top:1rem; }
.password-form{ display:flex; gap:0.6rem; align-items:center; justify-content:center; background: rgba(255,255,255,0.06); padding:0.6rem; border-radius:12px; border:1px solid rgba(0,0,0,0.06); box-shadow:0 6px 24px rgba(4,16,40,0.08); }
.password-input{ padding:0.7rem 0.9rem; border-radius:8px; border:1px solid rgba(0,0,0,0.08); min-width:180px; font-size:1rem; }
.password-button{ padding:0.7rem 0.9rem; border-radius:8px; background:var(--navy); color:white; border:none; cursor:pointer; font-weight:600; }
.password-button:hover{ opacity:0.95; }
.password-help{ font-size:0.9rem; color: rgba(7,26,58,0.75); text-align:center; }

/* Make sure countdown doesn't push form off-center on small screens */
@media (max-width:600px){
  .password-form{ flex-direction:column; gap:0.5rem; padding:0.8rem; }
  .password-input{ min-width:220px; width:64vw; }
  .logo{ width:40vw; max-width: 320px; }
}

/* Accessibility: reduced motion */
@media (prefers-reduced-motion: reduce){ .stage::before, .stage::after{ animation:none; } }

/* Utility: visually-hidden */
.visually-hidden{ position:absolute !important; height:1px; width:1px; overflow:hidden; clip:rect(1px,1px,1px,1px); white-space:nowrap; }
</style>

<script>
(function(){
  function updateCountdown() {
    const targetDate = new Date(2026, 9, 1, 23, 59, 59);
    const now = new Date();
    const timeRemaining = targetDate - now;
    if (timeRemaining <= 0) {
      ['days','hours','minutes','seconds'].forEach(id => { const el = document.getElementById(id); if(el) el.textContent = '0'; });
      return;
    }
    const days = Math.floor(timeRemaining / (1000 * 60 * 60 * 24));
    const hours = Math.floor((timeRemaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((timeRemaining % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((timeRemaining % (1000 * 60)) / 1000);
    const set = (id, val) => { const el = document.getElementById(id); if(el) el.textContent = String(val).padStart(2,'0'); };
    set('days', days); set('hours', hours); set('minutes', minutes); set('seconds', seconds);
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);
})();
</script>

{% schema %}
{
  "name": "Custom password landing",
  "settings": [
    { "type": "checkbox", "id": "show_logo", "label": "Show logo", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coming soon…" },
    { "type": "textarea", "id": "lead_text", "label": "Lead text", "default": "Moonbeam-Merch is getting ready. Stay tuned." },
    { "type": "checkbox", "id": "show_help_text", "label": "Show small help text under form", "default": true },
    { "type": "text", "id": "help_text", "label": "Help text", "default": "Enter the password shared with you to access the store." }
  ],
  "presets": [{ "name": "Custom password landing", "category": "Password" }]
}
{% endschema %}
